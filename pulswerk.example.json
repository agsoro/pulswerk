{
  "influxdb": {
    "url": "http://localhost:8086",
    "token": "connector-token",
    "org": "pulswerk",
    "bucket": "telemetries"
  },
  "database": {
    "retentionDays": 730,
    "compactionAfterDays": 700,
    "alarmRetentionDays": 30
  },
  "polling": {
    "intervalSeconds": 30
  },
  "connections": [
    {
      "id": "modbus-building-a",
      "type": "modbus-tcp",
      "address": "192.168.1.100",
      "port": 502
    },
    {
      "id": "modbus-building-b",
      "type": "modbus-tcp",
      "address": "192.168.1.101",
      "port": 502
    },
    {
      "id": "modbus-solis",
      "type": "modbus-tcp",
      "address": "10.10.1.21",
      "port": 502,
      "name": "Solis S6 Modbus"
    },
    {
      "id": "modbus-fronius",
      "type": "modbus-tcp",
      "address": "10.10.1.22",
      "port": 502,
      "name": "Fronius Modbus"
    },
    {
      "id": "bacnet-deziko",
      "type": "bacnet-ip",
      "localAddress": "0.0.0.0",
      "localPort": 47808,
      "localDeviceId": 1234
    },
    {
      "id": "ocpp-central",
      "type": "ocpp",
      "localPort": 5000,
      "localAddress": "/plswk/ocpp/",
      "name": "OCPP Central System"
    },
    {
      "id": "knx-test",
      "type": "knx-ip",
      "address": "192.168.1.15",
      "port": 3671,
      "knxSecureEnabled": true,
      // knxCommissioningPassword: Device authentication code (FDSK) printed on the device label as hyphen groups over several lines (a line break on the label = a hyphen). Enter as ONE line keeping the hyphens between every group, exact case, e.g. label 'ABCDE-ABCDE / ABCDE-ABCDE' becomes 'ABCDE-ABCDE-ABCDE-ABCDE'.",
      "knxCommissioningPassword": "ABCDE-ABCDE-ABCDE-ABCDE-ABCDE-ABCDE",
      "knxStaleSeconds": 180,
      "name": "KNX Test Gateway"
    }
  ],
  "devices": [
    {
      "id": "meter-main-a",
      "name": "Main Meter Building A",
      "deviceType": "janitza",
      "connectionId": "modbus-building-a",
      "deviceId": 1
    },
    {
      "id": "meter-sub-f2",
      "name": "Sub Meter Floor 2",
      "deviceType": "janitza",
      "connectionId": "modbus-building-b",
      "deviceId": 1
    },
    {
      "id": "meter-sub-f3",
      "name": "Sub Meter Floor 3",
      "deviceType": "janitza",
      "connectionId": "modbus-building-b",
      "deviceId": 2
    },
    {
      "id": "solis-pv",
      "name": "Solis S6 Solar PV",
      "deviceType": "solis-pv",
      "connectionId": "modbus-solis",
      "deviceId": 1,
      "path": [
        "Energy",
        "Solis PV"
      ],
      "assetType": "Inverter"
    },
    {
      "id": "solis-battery",
      "name": "Solis S6 Battery Storage",
      "deviceType": "solis-battery",
      "connectionId": "modbus-solis",
      "deviceId": 1,
      "path": [
        "Energy",
        "Solis Battery"
      ],
      "assetType": "Battery"
    },
    {
      "id": "solis-grid",
      "name": "Solis S6 Grid Meter",
      "deviceType": "solis-grid",
      "connectionId": "modbus-solis",
      "deviceId": 1,
      "path": [
        "Energy",
        "Solis Grid"
      ],
      "assetType": "Meter"
    },
    {
      "id": "fronius-inv-1",
      "name": "Fronius Inverter 1",
      "deviceType": "fronius",
      "connectionId": "modbus-fronius",
      "deviceId": 1,
      "path": [
        "Energy",
        "Fronius Inverter 1"
      ],
      "assetType": "Inverter"
    },
    {
      "id": "fronius-inv-2",
      "name": "Fronius Inverter 2",
      "deviceType": "fronius",
      "connectionId": "modbus-fronius",
      "deviceId": 2,
      "path": [
        "Energy",
        "Fronius Inverter 2"
      ],
      "assetType": "Inverter"
    },
    {
      "id": "meter-main",
      "name": "Main Meter",
      "deviceType": "janitza",
      "connectionId": "modbus-building-a",
      "deviceId": 10,
      "path": [
        "Building",
        "Main Meter"
      ],
      "assetType": "Meter"
    },
    {
      "id": "meter-sub",
      "name": "Sub Meter",
      "deviceType": "janitza",
      "connectionId": "modbus-building-a",
      "deviceId": 11,
      "path": [
        "Building",
        "Main Meter",
        "Sub Meter"
      ],
      "assetType": "Meter"
    },
    {
      "id": "meter-floor",
      "name": "Floor Meter",
      "deviceType": "janitza",
      "connectionId": "modbus-building-a",
      "deviceId": 12,
      "path": [
        "Building",
        "Main Meter",
        "Sub Meter",
        "Floor Meter"
      ],
      "assetType": "Meter Level"
    },
    {
      "id": "ctrl-zone-1",
      "name": "Glueck Controller Zone 1",
      "deviceType": "glueck",
      "connectionId": "modbus-building-a",
      "deviceId": 3
    },
    {
      "id": "asp01",
      "name": "ASP01",
      "deviceType": "deziko",
      "connectionId": "bacnet-deziko",
      "deviceId": 10,
      "assetType": "BACnet Node",
      "filter": {
        "excludeNamePattern": "^(UNUSED|SPARE|TEST)"
      }
    },
    {
      "id": "ahu-test-bacnet",
      "name": "Test BACnet AHU",
      "deviceType": "deziko",
      "connectionId": "bacnet-deziko",
      "deviceId": 20,
      "assetType": "BACnet Zone"
    },
    {
      "id": "analytics-summary",
      "name": "Analytics Summary",
      "deviceType": "virtual",
      "path": [
        "Building",
        "Analytics"
      ],
      "telemetries": [
        {
          "id": "total-pwr",
          "name": "Total Active Power",
          "formula": "pathsum(\"Building\", \"kW\")",
          "units": "kW"
        },
        {
          "id": "daily-kwh",
          "name": "Daily Consumption",
          "formula": "pathsum(\"Building\", \"kWh\"):consumption:1d",
          "units": "kWh/d"
        },
        {
          "id": "eff-ratio",
          "name": "Efficiency Ratio",
          "formula": "meter-main_energy_import / analytics-summary_area_sensor_m2",
          "units": "kWh/m2"
        },
        {
          "id": "area_sensor_m2",
          "name": "Building Area",
          "formula": "500",
          "units": "m2"
        },
        {
          "id": "building-energy-import-total",
          "name": "Sub Meter Total",
          "formula": "pathsum(\"Building/Main Meter/Sub Meter\", \"*_energy_import\")",
          "units": "kWh"
        }
      ]
    },
    {
      "id": "wallbox-sim-01",
      "name": "Garage Wallbox 1",
      "deviceType": "ocpp",
      "connectionId": "ocpp-central",
      "pollIntervalSeconds": 30,
      "path": [
        "Building A",
        "Garage",
        "Wallbox 1"
      ],
      "assetType": "Wallbox"
    },
    {
      "id": "knx-living-room",
      "name": "Living Room KNX",
      "deviceType": "knx",
      "connectionId": "knx-test",
      "path": [
        "Building A",
        "Living Room"
      ],
      "assetType": "KNX Controller",
      "knxGroupAddressXml": "ets_export.xml"
    }
  ],
  "server": {
    "port": 80,
    "logBufferSize": 5000,
    "auth": {
      "enabled": true,
      // IP addresses or CIDR ranges of reverse proxies (nginx/Authelia).
      // Remote-User/Groups/Name/Email headers are ONLY trusted from these sources.
      // When disabled, auth headers are stripped from ALL requests (safe default).
      "trustedProxies": [
        "10.192.30.1"
      ],
      // Fallback user/groups if no authentication headers are present.
      "defaultUser": "operator",
      "defaultGroups": [
        "operators"
      ]
    },
    // Role-based access control for write operations.
    "rights": {
      "enabled": true,
      // Groups allowed to change telemetry values (write-back).
      "allowAssetValueEdit": [
        "users",
        "admins"
      ],
      // Groups allowed to acknowledge alarms.
      "allowAlarmAck": [
        "users",
        "admins"
      ],
      // Groups allowed to edit dashboards (create, save, delete).
      "allowDashboardEdit": [
        "admins"
      ],
      // Groups allowed to pin/unpin favorites.
      "allowFavoriteEdit": [
        "users",
        "admins"
      ],
      "allowEms": [
        "admins",
        "operators"
      ],
      "allowBilling": [
        "admins"
      ],
      "allowWallbox": [
        "users",
        "admins"
      ],
      "allowHistoricalData": [
        "admins"
      ],
      "allowAlarms": [
        "users",
        "admins"
      ],
      "allowLogs": [
        "admins"
      ],
      "allowHeartbeat": [
        "users",
        "admins"
      ],
      "allowDashboards": [
        "users",
        "admins"
      ],
      "allowAssets": [
        "users",
        "admins"
      ],
      "allowTelemetry": [
        "users",
        "admins"
      ],
      "allowConnections": [
        "admins"
      ]
    }
  },
  "modules": {
    "ems": true,
    "billing": true,
    "wallbox": true,
    "historicalData": true,
    "alarms": true,
    "logs": true,
    "heartbeat": true,
    "dashboards": true,
    "assets": true,
    "telemetry": true,
    "connections": true
  }
}